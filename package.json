{
  "name": "eden-dance-platform",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace @eden/web run dev",
    "dev:api": "npm --workspace @eden/api run dev",
    "build": "npm --workspace @eden/web run build && npm --workspace @eden/api run typecheck",
    "deploy": "npm run build && npm --workspace @eden/api run deploy",
    "typecheck": "npm --workspace @eden/web run typecheck && npm --workspace @eden/api run typecheck",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "validate": "npm run build && node scripts/validate.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
